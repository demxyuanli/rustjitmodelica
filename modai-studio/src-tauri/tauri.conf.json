{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Modai Studio",
  "version": "0.1.0",
  "identifier": "com.rustmodlica.modai-studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Modai Studio",
        "label": "main",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "decorations": false,
        "center": true,
        "theme": "Dark",
        "scrollBarStyle": "fluentOverlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../examples"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
